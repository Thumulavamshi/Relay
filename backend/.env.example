# The backend reads backend/.env, then repo-root .env, then
# experiments/voice-feasibility/.env - so existing credentials are picked up
# with nothing to re-enter. Only set values here to OVERRIDE those.

# VAPI_API_KEY=
# VAPI_PHONE_NUMBER_ID=
# VAPI_ASSISTANT_ID=

# The ONE number POST /calls may dial. Falls back to TEST_NUMBER when unset.
# Set this to the evaluator's number ONLY for a deliberate production run.
# ALLOWED_DESTINATION=+919XXXXXXXXX

# Shared secret for the webhook. Unset locally; set before deploying, and add
# the same value as an x-vapi-secret header on the Vapi server URL.
# VAPI_WEBHOOK_SECRET=

# DATABASE_PATH=backend/data/elevatebox.db

# --- WhatsApp -------------------------------------------------------------
# WHATSAPP_PROVIDER=ultramsg   # or "meta". Auto-selects ultramsg if a token is set.
#
# UltraMsg: an UNOFFICIAL gateway driving a linked WhatsApp account. Chosen only
# because Meta business verification and Twilio both dead-ended on KYC. It has no
# templates, no approval queue and no 24-hour window, and it accepts local files
# as base64 so no media hosting is needed.
# THIS MUST BE DISCLOSED IN THE UNDER-200-WORD NOTE. See backend/app/ultramsg.py.
# ULTRAMSG_INSTANCE_ID=instance000000
# ULTRAMSG_TOKEN=

# Official path, kept intact so it can be taken back the moment a verified
# sender exists.
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=

# URL or LOCAL PATH. UltraMsg inlines a local file as base64; Meta needs a URL.
# WHATSAPP_ARCHITECTURE_IMAGE_URL=./assets/architecture.png
# WHATSAPP_RESUME_URL=./assets/resume.pdf
# WHATSAPP_RESUME_FILENAME=Vamshidhar-Thumula-Resume.pdf

# Signed at the bottom of every message; the number is a Section 06 requirement.
# YOUR_NAME=
# YOUR_MOBILE_NUMBER=
# DEMO_URL=
# REPO_URL=

# --- Understanding lane (classification + extraction) ----------------------
# groq | anthropic | gemini. Groq runs over stdlib HTTP with a strict JSON schema.
# CLASSIFIER_PROVIDER=groq
# CLASSIFIER_MODEL=openai/gpt-oss-20b
# GROQ_API_KEY=

# --- Multi-app layer ------------------------------------------------------
# Every app is optional: one with no credentials is never called, and /health
# says so. Put ALL keys in ONE .env file - only the first one found is read.

# Google Calendar: OAuth client + refresh token for the rep's own account.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# GOOGLE_CALENDAR_ID=primary

# HubSpot: private (legacy) app token with contacts + deals read/write.
# Stage ids belong to the portal - GET /crm/v3/pipelines/deals lists yours.
# HUBSPOT_TOKEN=
# HUBSPOT_PORTAL_ID=
# HUBSPOT_PIPELINE_ID=default
# HUBSPOT_STAGE_HOT=
# HUBSPOT_STAGE_WARM=

# Slack: bot token with chat:write, and the bot invited to the channel.
# SLACK_BOT_TOKEN=
# SLACK_CHANNEL_ID=

# Where links in Slack, HubSpot and Calendar point back to (falls back to SERVER_URL).
# PUBLIC_BASE_URL=
# Vapi PUBLIC key - enables the browser web call on the start page.
# VAPI_PUBLIC_KEY=
